# TypeScript bot (bot-ts). Build from the repo root: docker build -f Dockerfile.node .
FROM node:22-slim AS build
WORKDIR /app/bot-ts
COPY bot-ts/package.json bot-ts/package-lock.json ./
RUN npm ci
COPY bot-ts/tsconfig.json ./
COPY bot-ts/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
# loader.ts resolves data/ four levels above dist/data/loader.js: /app/data
COPY data ./data
COPY --from=build /app/bot-ts/package.json ./bot-ts/package.json
COPY --from=build /app/bot-ts/node_modules ./bot-ts/node_modules
COPY --from=build /app/bot-ts/dist ./bot-ts/dist
# node image ships a non-root "node" user (uid 1000)
# error_log.txt is appended to the working directory, so it must be writable
RUN chown node:node /app/bot-ts
USER node
WORKDIR /app/bot-ts
CMD ["node", "dist/main.js"]
